  "audience": "业务负责人、服务与运营人员",
  "goal": "从文件数据观察品牌可见度，追溯异常记录并演示行动处理。",
  "solution": "使用关联CSV/JSON构建分析快照，筛选品牌、日期和渠道，追溯明细后处理对应模拟行动；不推断尚未实测的行动效果。",
  "confirmed": true,
  "prompts": [
    "请解释当前品牌提及率的口径和样本范围",
    "请分析当前看板，并区分观察、假设和建议",
    "如何验证行动是否带来真实业务提升？"
  ],
  "steps": [
    {
      "question": "使用CSV观察记录与JSON品牌字典生成应用",
      "expected": "文件类型、日期、布尔值、主键与关联通过校验"
    },
    {
      "question": "筛选演示品牌A和日期范围，点击指标下钻",
      "expected": "汇总、图表、明细和问答采用相同筛选范围"
    },
    {
      "question": "查看观察记录及关联品牌字典",
      "expected": "可追溯原始数据来源和业务关联"
    },
    {
      "question": "打开行动GEO-A001，建立草稿并确认模拟处理",
      "expected": "产生模拟回执，状态与运营指标发生变化"
    },
    {
      "question": "记录结果后重新查看分析快照",
      "expected": "已处理行动增加；历史提及率不会因模拟操作而被改写"
    }
  ],
  "acceptance": [
    "文件类型、日期、布尔值、主键与关联通过校验",
    "汇总、图表、明细和问答采用相同筛选范围",
    "可追溯原始数据来源和业务关联",
    "产生模拟回执，状态与运营指标发生变化",
    "已处理行动增加；历史提及率不会因模拟操作而被改写"
