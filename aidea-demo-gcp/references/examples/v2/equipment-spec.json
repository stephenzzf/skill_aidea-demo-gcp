{
  "version": 2,
  "id": "equipment-v2",
  "customer": "示例器材品牌",
  "assistantName": "业务方案助手",
  "title": "选购与服务工作台",
  "subtitle": "让同一选购案例完成需求确认、问题核实、服务交接和结果反馈。",
  "audience": "业务负责人、服务与运营人员",
  "goal": "让同一选购案例完成需求确认、问题核实、服务交接和结果反馈。",
  "solution": "以业务案例连接顾客、选购顾问与服务人员，用分析看板观察待办及咨询结果；AI提供解释与建议，业务动作由页面确认。",
  "confirmed": true,
  "prompts": [
    "请分析当前看板的待核实情况",
    "我想选旅行拍摄器材，预算和设备还没确定，请帮我澄清",
    "请说明当前案例还需要哪些证据才能完成交接"
  ],
  "steps": [
    {
      "question": "在业务处理选择 UL-DEMO-001，补充需求并确认候选",
      "expected": "案例从需求澄清进入候选确认，候选编号引用器材记录"
    },
    {
      "question": "修改快拆需求，再次比较候选",
      "expected": "旧建议标为待重评；重评完成前不能交接"
    },
    {
      "question": "提交适配问题，预览并确认模拟交接",
      "expected": "待交接数增加，活动记录出现模拟回执"
    },
    {
      "question": "切到服务处理，接收后退回补充一次，再重新交接",
      "expected": "保留需补充原因，同一案例继续流转"
    },
    {
      "question": "补充合成核实依据和回复，顾客确认并记录反馈",
      "expected": "案例完成，咨询完成率随状态计算，未声称购买或真实工单创建"
    }
  ],
  "acceptance": [
    "案例从需求澄清进入候选确认，候选编号引用器材记录",
    "旧建议标为待重评；重评完成前不能交接",
    "待交接数增加，活动记录出现模拟回执",
    "保留需补充原因，同一案例继续流转",
    "案例完成，咨询完成率随状态计算，未声称购买或真实工单创建"
  ],
