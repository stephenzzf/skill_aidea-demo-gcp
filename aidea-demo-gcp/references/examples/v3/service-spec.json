        "fields": [
          {
            "id": "id",
            "label": "设备编号",
            "type": "string",
            "required": true
          },
          {
            "id": "type",
            "label": "设备类型",
            "type": "string",
            "required": true
          },
          {
            "id": "model",
            "label": "型号",
            "type": "string",
            "required": true
          },
          {
            "id": "installed",
            "label": "安装日期",
            "type": "date",
            "required": true
          }
        ]
      },
      {
        "id": "touchpoints",
        "label": "服务活动",
        "key": "id",
        "origin": "synthetic",
        "source": "固定种子服务活动，合成演示数据",
        "fields": [
          {
            "id": "id",
            "label": "活动编号",
            "type": "string",
            "required": true
          },
          {
            "id": "case_id",
            "label": "服务案例",
            "type": "string",
            "required": true
          },
          {
            "id": "day",
            "label": "活动日期",
            "type": "date",
            "required": true
          },
          {
            "id": "activity",
            "label": "服务活动",
            "type": "string",
            "required": true
          },
          {
            "id": "note",
            "label": "活动说明",
            "type": "string"
          }
        ],
        "relations": [
          {
            "field": "case_id",
            "dataset": "cases",
            "target": "id"
          }
        ]
      }
    ],
    "metrics": [
      {
        "id": "new_cases",
        "label": "新受理案例",
        "dataset": "cases",
        "operation": "count",
        "filters": [
          {
            "field": "status",
            "op": "eq",
            "value": "new"
          }
        ],
        "description": "当前待受理案例数，按演示记录确定性计算。",
        "scope": "current",
        "groupBy": "severity",
        "timeField": "day"
      },
      {
        "id": "open_cases",
        "label": "处理中案例",
        "dataset": "cases",
        "operation": "count",
        "filters": [
          {
            "field": "status",
            "op": "eq",
            "value": "working"
          }
        ],
        "description": "当前处理中案例数，不代表真实服务 SLA。",
        "scope": "current",
        "groupBy": "severity",
        "timeField": "day"
      },
      {
        "id": "service_activities",
        "label": "服务活动数",
        "dataset": "touchpoints",
        "operation": "count",
        "description": "当前筛选范围的合成服务活动记录。",
        "scope": "snapshot",
        "groupBy": "activity",
        "timeField": "day"
      },
      {
        "id": "closure_rate",
        "label": "演示案例完成率",
        "dataset": "cases",
        "operation": "ratio",
        "numerator": [
          {
            "field": "status",
            "op": "eq",
            "value": "closed"
          }
        ],
        "denominator": [],
        "unit": "%",
        "description": "合成案例中已完成数 / 当前范围案例数，不是客户服务绩效。",
        "scope": "current",
        "timeField": "day"
      }
    ],
    "workflow": {
      "dataset": "cases",
      "statusField": "status",
      "staleField": "stale",
      "editableFields": [
        "severity",
        "issue",
        "resolution",
        "evidence",
        "feedback"
      ],
      "transitions": [
        {
          "id": "triage",
          "label": "分类并接收",
          "from": [
            "new"
          ],
          "to": "triaged",
          "role": "coordinator",
          "inputFields": [
            {
              "id": "severity",
              "label": "影响级别",
              "type": "string",
              "required": true
            }
          ],
          "requiredFields": [
            "severity"
          ]
        },
        {
          "id": "dispatch",
          "label": "模拟交接处理",
          "from": [
            "triaged"
          ],
          "to": "working",
          "role": "coordinator",
          "inputFields": [],
          "requiredFields": []
        },
        {
          "id": "request_more",
          "label": "退回补充",
          "from": [
            "working"
          ],
          "to": "new",
          "role": "technician",
          "inputFields": [
            {
              "id": "issue",
              "label": "需要补充的信息",
              "type": "string",
              "required": true
            }
          ],
          "requiredFields": [
            "issue"
          ],
          "invalidates": true
        },
        {
          "id": "resolve",
          "label": "记录处理结果",
          "from": [
            "working"
          ],
          "to": "resolved",
          "role": "technician",
          "inputFields": [
            {
              "id": "resolution",
              "label": "处理结果",
              "type": "string",
              "required": true
            },
            {
              "id": "evidence",
              "label": "验证证据",
              "type": "string",
              "required": true
            }
          ],
          "requiredFields": [
            "resolution",
            "evidence"
          ]
        },
        {
          "id": "close",
          "label": "确认完成并记录反馈",
          "from": [
            "resolved"
          ],
          "to": "closed",
          "role": "quality",
          "inputFields": [
            {
              "id": "feedback",
              "label": "客户反馈",
              "type": "string",
              "required": true
            }
          ],
          "requiredFields": [
            "resolution",
            "evidence",
            "feedback"
          ]
        }
      ]
    }
  },
  "design": {
    "facts": [
      "当前示例只演示设备服务案例、资产关联和状态闭环。"
    ],
    "assumptions": [
      "所有人员、客户、设备、活动和案例均为合成记录。",
      "真实派工系统、身份权限、通知通道和服务SLA尚未提供。"
    ],
    "implementation": [
      "阶段一：验证本地服务闭环、数据关系与领域导航。",
      "阶段二：确认客户权威系统、服务规则和授权后评估接入。"
    ],
