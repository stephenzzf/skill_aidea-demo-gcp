{
  "version": 3,
  "id": "service-operations-v3",
  "customer": "设备服务演示案例",
  "assistantName": "服务协调助手",
  "title": "设备服务与履约协作",
  "subtitle": "从服务受理到解决反馈，按领域追踪同一服务案例。",
  "audience": "服务协调员、现场技术人员、服务质量负责人",
  "goal": "让服务团队从统一案例识别影响、协调核实、完成处理并回读服务反馈。",
  "solution": "把客户报修、设备与服务活动关联到同一案例。服务受理领域负责分类、分派及必要补充；履约跟进领域记录处理进度、解决证据与客户反馈。看板使用合成案例确定性统计，模拟动作只改变演示事件，不触发真实通知或派工。",
  "confirmed": true,
  "prompts": [
    "当前哪些案例等待处理？",
    "这台设备最近有什么服务记录？",
    "完成案例后哪些服务指标会变化？"
  ],
  "steps": [
    {
      "id": "intake-case",
      "question": "打开待受理案例 SR-204 并确认设备与影响级别。",
      "expected": "展示关联设备、来源和当前状态。",
      "role": "coordinator",
      "pageId": "intake",
      "preconditions": [
        "使用提供的合成演示案例。"
      ],
      "inputs": [
        "案例 SR-204"
      ],
      "observation": "设备序列号、问题摘要与状态同一案例记录一致。",
      "claimIds": [
        "case-linked"
      ]
    },
    {
      "id": "handoff-case",
      "question": "补齐必要信息并模拟交接给现场服务。",
      "expected": "案例进入处理中，页面显示本地模拟回执。",
      "role": "coordinator",
      "pageId": "intake",
      "preconditions": [
        "案例处于待受理。"
      ],
      "inputs": [
        "问题类别和影响说明"
      ],
      "observation": "只有服务状态改变，未创建真实派工或发送消息。",
      "claimIds": [
        "simulated-handoff"
      ]
    },
    {
      "id": "resolve-case",
      "question": "记录合成处理结果和验证证据，再关闭案例。",
      "expected": "处理结果及相关活动可在履约跟进中回读，当前运营计数更新。",
      "role": "technician",
      "pageId": "fulfillment",
      "preconditions": [
        "案例处于处理中。"
      ],
      "inputs": [
        "处理记录、验证证据"
      ],
      "observation": "同一案例关联记录可追溯；历史客户满意度不因模拟关闭而改变。",
      "claimIds": [
        "case-linked",
        "simulated-handoff"
      ]
    }
  ],
  "acceptance": [
    "案例和设备引用有效且数据标为合成。",
    "交接后状态及模拟回执可查看。",
    "跨领域读取同一案例与服务活动。",
    "模拟处理不改写历史快照或触发真实通知。"
  ],
  "model": {
    "project": "",
    "location": "",
    "model": ""
  },
  "workspace": {
    "views": [
      "overview",
      "records",
      "workflow",
      "assistant"
    ],
    "roles": [
      {
        "id": "coordinator",
        "label": "服务协调员"
      },
      {
        "id": "technician",
        "label": "现场技术人员"
      },
      {
        "id": "quality",
        "label": "服务质量"
      }
    ],
    "stages": [
      {
        "id": "new",
        "label": "待受理"
      },
      {
        "id": "triaged",
        "label": "已分类"
      },
      {
        "id": "working",
        "label": "处理中"
      },
      {
        "id": "resolved",
        "label": "待结果确认"
      },
      {
        "id": "closed",
        "label": "已完成"
      }
    ],
    "datasets": [
      {
        "id": "cases",
        "label": "服务案例",
