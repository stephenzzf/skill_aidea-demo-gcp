        "origin": "synthetic",
        "source": "固定种子服务案例，合成演示数据",
        "fields": [
          {
            "id": "id",
            "label": "案例编号",
            "type": "string",
            "required": true
          },
          {
            "id": "status",
            "label": "处理状态",
            "type": "string",
            "required": true
          },
          {
            "id": "day",
            "label": "报修日期",
            "type": "date",
            "required": true
          },
          {
            "id": "customer_id",
            "label": "客户编号",
            "type": "string",
            "required": true
          },
          {
            "id": "asset_id",
            "label": "设备编号",
            "type": "string",
            "required": true
          },
          {
            "id": "issue",
            "label": "问题摘要",
            "type": "string",
            "required": true
          },
          {
            "id": "severity",
            "label": "影响级别",
            "type": "string",
            "required": true
          },
          {
            "id": "resolution",
            "label": "处理结果",
            "type": "string"
          },
          {
            "id": "evidence",
            "label": "验证证据",
            "type": "string"
          },
          {
            "id": "feedback",
            "label": "客户反馈",
            "type": "string"
          },
          {
            "id": "stale",
            "label": "建议待重评",
            "type": "boolean",
            "required": true
          }
        ],
        "relations": [
          {
            "field": "customer_id",
            "dataset": "customers",
            "target": "id"
          },
          {
            "field": "asset_id",
            "dataset": "assets",
            "target": "id"
          }
        ]
      },
      {
        "id": "customers",
        "label": "演示客户",
        "key": "id",
        "origin": "synthetic",
        "source": "虚构客户资料，仅供流程演示",
        "fields": [
          {
            "id": "id",
            "label": "客户编号",
            "type": "string",
            "required": true
          },
          {
            "id": "name",
            "label": "演示客户名称",
            "type": "string",
            "required": true
          },
          {
            "id": "region",
            "label": "服务地区",
            "type": "string",
            "required": true
          }
        ]
      },
